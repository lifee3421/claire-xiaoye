rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Dashboard goal image — one fixed object per user, owner-only access.
    // The MIME type is carried via Storage metadata contentType, so the path
    // has no file extension and the same logical object can hold png/jpg/webp.
    match /users/{uid}/dashboard/goal-image {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
