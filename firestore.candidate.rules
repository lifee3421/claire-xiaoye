rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── User document ──────────────────────────────────────────────────
    // Server-owned fields that clients can NEVER create/change/remove.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(
                         ['points', 'rewardTotalEarned', 'rewardTotalSpent']);
      // affectedKeys() = addedKeys + changedKeys + removedKeys.
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasAny(['points', 'rewardTotalEarned', 'rewardTotalSpent']);
      allow delete: if false;
    }

    // ── All subcollections ─────────────────────────────────────────────
    // Owner can read, but writes to financial/reward/challenge authority
    // collections must go through the Admin-SDK API. This list is deliberately
    // explicit; Firestore match rules are ORed, so there is no overlapping
    // broad write rule elsewhere that could re-enable them.
    match /users/{userId}/{collection}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && collection != 'rewardInstances'
                   && collection != 'rewardIdempotency'
                   && collection != 'pointTransactions'
                   && collection != 'rewardChallenges'
                   && collection != 'rewardChallengeClaims'
                   && collection != 'rewardNotifications';
    }
  }
}